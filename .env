# Copia este archivo a .env y ajusta los valores.

# --- MySQL local (root / 1234). En Railway se pisan con las vars del plugin. ---
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLDATABASE=auth_db
MYSQLUSER=root
MYSQLPASSWORD=1234
MYSQL_SSL=false

# --- JWT (en producción DEBE ser un secreto fuerte, mínimo 32 caracteres) ---
JWT_SECRET=local-dev-only-secret-key-32-chars-min
JWT_ISSUER=auth-base
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P14D

# --- HTTP ---
PORT=8080
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# Admin inicial (se crea solo si la tabla users está vacía)
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AUTH_BOOTSTRAP_ADMIN_PASSWORD=Admin1234!
AUTH_BOOTSTRAP_ADMIN_NAME=Administrador
